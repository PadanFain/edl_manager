{
  "info": {
    "name": "EDL Manager v1.5.0",
    "_postman_id": "edl-manager-v1-5-0",
    "description": "Complete test suite for all EDL Manager REST endpoints.\n\nSetup:\n1. Set collection variables: base_url, username, password\n2. Run '0. Auth — Get Session Token' first — sets {{splunk_token}} automatically\n3. All other requests use {{splunk_token}} via Bearer auth\n\nCRITICAL: All POST requests use Body > x-www-form-urlencoded with ONE key:\n  key: payload\n  value: <JSON string>\nThis is because PSCA (Splunk 10.x) silently drops application/json bodies.\nThe Python handler reads request['form'][0][1] and JSON-parses it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "https://localhost:8089", "type": "string" },
    { "key": "username",      "value": "admin",                  "type": "string" },
    { "key": "password",      "value": "changeme",               "type": "string" },
    { "key": "splunk_token",  "value": "",                       "type": "string" },
    { "key": "policy_key",   "value": "",                        "type": "string" },
    { "key": "ioc_key",      "value": "",                        "type": "string" },
    { "key": "token_key",    "value": "",                        "type": "string" },
    { "key": "edl_token_raw","value": "",                        "type": "string" },
    { "key": "taxii_key",    "value": "",                        "type": "string" },
    { "key": "conflict_key", "value": "",                        "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{splunk_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Get Session Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "const token = json.sessionKey;",
            "if (token) {",
            "  pm.collectionVariables.set('splunk_token', token);",
            "  pm.test('Session token extracted', () => pm.expect(token).to.not.be.empty);",
            "} else {",
            "  pm.test('Session token found', () => pm.expect.fail('No sessionKey in response'));",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/services/auth/login?output_mode=json", "host": ["{{base_url}}"], "path": ["services","auth","login"], "query": [{ "key": "output_mode", "value": "json" }] },
            "description": "Authenticates and stores the session token as {{splunk_token}}. Run this first."
          }
        }
      ]
    },
