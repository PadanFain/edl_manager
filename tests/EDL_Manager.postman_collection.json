{
  "info": {
    "name": "EDL Manager v1.5.0",
    "_postman_id": "edl-manager-v1-5-0",
    "description": "Complete test suite for all EDL Manager REST endpoints.\n\nSetup:\n1. Set the collection variables: base_url, username, password\n2. Run '0. Auth — Get Session Token' first — it sets {{splunk_token}} automatically\n3. All other requests use {{splunk_token}} via Bearer auth\n\nEndpoint base: {{base_url}}/servicesNS/nobody/edl_manager/edl_manager/\n\nAuth options tested:\n- Splunk session token (most requests)\n- EDLToken for feed endpoint (firewall simulation)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "https://localhost:8089",  "type": "string" },
    { "key": "username",      "value": "admin",                   "type": "string" },
    { "key": "password",      "value": "changeme",                "type": "string" },
    { "key": "splunk_token",  "value": "",                        "type": "string" },
    { "key": "policy_key",    "value": "",                        "type": "string" },
    { "key": "ioc_key",       "value": "",                        "type": "string" },
    { "key": "token_key",     "value": "",                        "type": "string" },
    { "key": "edl_token_raw", "value": "",                        "type": "string" },
    { "key": "taxii_key",     "value": "",                        "type": "string" },
    { "key": "conflict_key",  "value": "",                        "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{splunk_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Get Session Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const xml = pm.response.text();",
                  "const match = xml.match(/<sessionKey>([^<]+)<\\/sessionKey>/);",
                  "if (match) {",
                  "  pm.collectionVariables.set('splunk_token', match[1]);",
                  "  pm.test('Session token extracted', () => pm.expect(match[1]).to.not.be.empty);",
                  "} else {",
                  "  pm.test('Session token found', () => pm.expect.fail('No sessionKey in response'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/services/auth/login?output_mode=json", "host": ["{{base_url}}"], "path": ["services","auth","login"], "query": [{ "key": "output_mode", "value": "json" }] },
            "description": "Authenticates and stores the session token as {{splunk_token}}. Run this first."
          }
        }
      ]
    },
    {
